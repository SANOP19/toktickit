// [Prisma Generator Config] Generate JavaScript/TypeScript client
generator client {
  provider = "prisma-client-js"
}

// [Database Datasource Config] PostgreSQL Database connection
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

